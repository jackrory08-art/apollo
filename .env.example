# Apollo racing pipeline — environment configuration
# Copy to `.env` and fill in your own values.

# --- Supabase Postgres (used by setup_db.py, pipeline.py, app.py) ---
# Find this under: Supabase project → Settings → Database → Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- PuntersEdge scraper's SQL Server (read by pipeline.py) ---
# The scraper is a VB.NET app that writes to SQL Server ("PuntersEdgeDB").
# pipeline.py reads its output here. Leave SQLSERVER_HOST blank to skip ingest
# and run the model against data already in Supabase.
SQLSERVER_HOST=<your-rds-or-server-hostname>
SQLSERVER_DB=PuntersEdge
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# --- Dashboard ---
# PIN required to open the Streamlit dashboard (defaults to 2828 if unset).
DASHBOARD_PIN=2828

# NOTE: The SQL Server source carries odds/market fields only. The form columns
# (barrier, jockey, trainer, weight, last_start_date, track_condition) stay empty
# until a form-data source populates them; the model's form features activate
# automatically once they do.
