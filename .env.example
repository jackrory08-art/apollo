# Apollo racing pipeline — environment configuration
# Copy to `.env` and fill in your own values.

# --- Supabase (used by pipeline.py and app.py via HTTP client) ---
# Find these under: Supabase project → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- Supabase Postgres direct connection (used by setup_db.py only) ---
# Find this under: Supabase project → Project Settings → Database → Connection string
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Data source ---
# betfair    → official Betfair Exchange API, AU racing (default, recommended)
# punters    → scrape punters.com.au (blocked by bot protection; reference only)
# sqlserver  → legacy PuntersEdge SQL Server DB
DATA_SOURCE=betfair

# --- Betfair API (used when DATA_SOURCE=betfair) ---
# Get a free "delayed" Application Key + account at https://developer.betfair.com/
BF_APP_KEY=
BF_USERNAME=
BF_PASSWORD=
# BF_IDENTITY_URL=https://identitysso.betfair.com.au/api/login  # AU accounts
# BF_DEBUG=1

# --- Legacy PuntersEdge SQL Server (only used when DATA_SOURCE=sqlserver) ---
SQLSERVER_HOST=
SQLSERVER_DB=PuntersEdge
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# --- Dashboard ---
DASHBOARD_PIN=2828

# NOTE: The SQL Server source carries odds/market fields only. The form columns
# (barrier, jockey, trainer, weight, last_start_date, track_condition) stay empty
# until a form-data source populates them; the model's form features activate
# automatically once they do.
