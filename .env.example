# Apollo racing pipeline — environment configuration
# Copy to `.env` and fill in your own values.

# --- Supabase (used by pipeline.py and app.py via HTTP client) ---
# Find these under: Supabase project → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- Supabase Postgres direct connection (used by setup_db.py only) ---
# Find this under: Supabase project → Project Settings → Database → Connection string
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Data source ---
# betfair    → official Betfair Exchange API, AU racing (default, recommended)
# punters    → scrape punters.com.au (blocked by bot protection; reference only)
# sqlserver  → legacy PuntersEdge SQL Server DB
DATA_SOURCE=betfair

# --- Betfair API (used when DATA_SOURCE=betfair) ---
# Get a free "delayed" Application Key + account at https://developer.betfair.com/
BF_APP_KEY=
BF_USERNAME=
BF_PASSWORD=

# Recommended for unattended pipeline runs. Upload the certificate to your
# Betfair account, then point these at your local cert/key files.
BF_LOGIN_MODE=auto
# BF_LOGIN_MODE=cert
BF_CERT_FILE=
BF_KEY_FILE=
# BF_CERT_IDENTITY_URL=https://identitysso-cert.betfair.com.au/api/certlogin  # AU/NZ

# Local testing fallback only; use cert mode for automation.
# BF_LOGIN_MODE=interactive
# BF_INTERACTIVE_IDENTITY_URL=https://identitysso.betfair.com.au/api/login  # AU/NZ

BF_TIMEZONE=Australia/Sydney
BF_MARKET_COUNTRIES=AU
BF_MARKET_TYPES=WIN
BF_MAX_RESULTS=200
# BF_DEBUG=1

# --- Horse history / form enrichment ---
# none  → use only Apollo's own stored results as history
# csv   → import a historical form/results CSV
# api   → call a JSON provider once per horse using ?horse=<HORSE_NAME>
HISTORY_SOURCE=none
# HISTORY_CSV_PATH=C:\path\to\horse_history.csv
# HISTORY_API_URL=https://example.com/horse-history
# HISTORY_API_KEY=
# HISTORY_SOURCE_NAME=form_provider_name

# --- Legacy PuntersEdge SQL Server (only used when DATA_SOURCE=sqlserver) ---
SQLSERVER_HOST=
SQLSERVER_DB=PuntersEdge
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# --- Dashboard ---
DASHBOARD_PIN=2828

# NOTE: The SQL Server source carries odds/market fields only. The form columns
# (barrier, jockey, trainer, weight, last_start_date, track_condition) stay empty
# until a form-data source populates them; the model's form features activate
# automatically once they do.
